generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id              String   @id @default(cuid())
  title           String
  subtitle        String
  description     String
  longDescription String?
  image           String
  techStackRaw    String
  keyFeaturesRaw  String?
  githubUrl       String?
  liveUrl         String?
  index           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}